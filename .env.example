# Copy to .env.local and fill in, or use `vercel env pull .env.local` (see README).
# Never commit real values — .env.local is gitignored.

# Public (shipped to the browser): Mwasya's Deriv App ID
VITE_DERIV_APP_ID=

# Server only
DERIV_APP_ID=
# Must exactly match a redirect URI on the Deriv app. Local: http://localhost:3000/callback
DERIV_REDIRECT_URI=http://localhost:3000/callback
# 32+ random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Postgres (Neon pooled URL). Added automatically by `vercel integration add neon`.
# After setting it: npm run db:migrate
DATABASE_URL=
